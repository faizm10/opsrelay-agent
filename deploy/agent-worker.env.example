# Server-side configuration for the OpsRelay investigation worker. Keep the real file in the
# host's secret store (never in the repo); pass it with `docker run --env-file`.

OPSRELAY_ENV=production
# Atlas user with readWrite on the opsrelay database only.
MONGODB_URI=
MONGODB_DB=opsrelay
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Read-only fine-grained token scoped to the repository below:
# Actions read, Contents read, Pull requests read, Metadata read.
GITHUB_TOKEN=
GITHUB_OWNER=faizm10
GITHUB_REPO=opsrelay-agent
GITHUB_BASE_BRANCH=main

# Report-only while this is empty. To enable draft PRs for a repository, list it here and set
# GITHUB_PUBLISH_TOKEN: a second fine-grained token for the same repository with Contents
# write and Pull requests write. Only the publisher receives it. Merges stay with humans.
OPSRELAY_PUBLISH_REPOS=
GITHUB_PUBLISH_TOKEN=

# Deployment evidence for merged fixes, required once publishing is on: for each app in
# agents/apps.toml, OPSRELAY_<APP>_VERSION_URL and OPSRELAY_<APP>_PROBE_URL.

# Verifier: auto uses a disposable container per pytest run (no network, CPU/memory/pid limits) when
# Docker is reachable and an image is set; otherwise tests run as plain processes (logged as a fallback).
# DOCKER_HOST should be a separate runner host with no production credentials, over TLS
# (tcp://runner:2376 with DOCKER_TLS_VERIFY=1 and client certs mounted at DOCKER_CERT_PATH).
OPSRELAY_VERIFIER_RUNNER=auto
OPSRELAY_VERIFIER_IMAGE=opsrelay-agent-worker:REPLACE_WITH_TAG
OPSRELAY_VERIFIER_CPUS=1
OPSRELAY_VERIFIER_MEMORY=1g
DOCKER_HOST=
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/certs

OPSRELAY_MAX_CONCURRENCY=2
POLL_SECONDS=30
OPSRELAY_SHUTDOWN_GRACE_SECONDS=60
LEASE_SECONDS=120
MAX_ATTEMPTS=3
OPSRELAY_LIVE_INTAKE=1
