# OpsRelay uptime monitor + status dashboard. Copy to admin-dashboard/.env (git-ignored).
# Non-secret examples only. Never commit real credentials.

# --- Storage -------------------------------------------------------------
# auto (default): MongoDB when MONGODB_URI is set, otherwise local development storage (SQLite).
# mongodb: require MongoDB (fails loudly instead of falling back). sqlite: force local dev storage.
OPSRELAY_STORAGE=auto
# Same variables as agents/mongodb.py (shared Atlas database, dedicated uptime_* collections).
MONGODB_URI=
MONGODB_DB=opsrelay_dev
# Local development storage file (used only when not on MongoDB)
OPSRELAY_SQLITE_PATH=

# --- Monitoring ----------------------------------------------------------
# Production/demo default is 30 seconds. Lower only for local experiments.
OPSRELAY_MONITOR_INTERVAL=30
OPSRELAY_CHECK_RETENTION_DAYS=35
# Lease TTL for the single active worker (default 2 x interval + 10 s)
OPSRELAY_LEASE_TTL=

# --- API -----------------------------------------------------------------
OPSRELAY_API_HOST=127.0.0.1
OPSRELAY_API_PORT=8300
# 1 refuses sites that resolve to private/internal addresses (on for shared deployments)
OPSRELAY_BLOCK_PRIVATE_URLS=
OPSRELAY_DASHBOARD_ORIGINS=http://localhost:3300

# --- Dashboard (web/) ----------------------------------------------------
# Where the Next.js server proxies /api/* (server-side only)
OPSRELAY_UPTIME_API_URL=http://127.0.0.1:8300
